{
	"name": "ts-nameof-proxy",
	"version": "1.0.1",
	"description": "`nameof` in TypeScript, no compiler required. Implemented using proxy with some limitations.",
	"keywords": [
		"nameof",
		"formik"
	],
	"author": "pinkchampagne",
	"homepage": "https://github.com/p-toy-factory/ts-nameof-proxy",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "tsdown",
    "fmt": "oxfmt --check src",
    "fmt:fix":"oxfmt --write src",
		"lint": "oxlint src",
		"lint:fix": "oxlint src --fix",
		"test": "vitest run"
	},
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"files": [
		"dist/**/*.*"
	],
	"devDependencies": {
		"oxlint": "^1.74.0",
		"tsdown": "^0.22.9",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	}
}
