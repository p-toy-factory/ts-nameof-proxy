{
  "include": ["./src"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noImplicitAny": true,
    "module": "ESNext",
    "target": "ESNext",
    "allowJs": true,
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "removeComments": true
  }
}
